# ---- Postgres / TimescaleDB ----
POSTGRES_USER=contrail
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=contrail
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://contrail:changeme_local_dev_only@localhost:5432/contrail

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Redpanda (Kafka API) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ---- MinIO (S3-compatible) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=contrail
MINIO_SECRET_KEY=changeme_local_dev_only
MINIO_BUCKET=contrail
MINIO_SECURE=false

# ---- ADS-B data sources ----
ADSB_LOL_BASE_URL=https://api.adsb.lol/v2
AIRPLANES_LIVE_BASE_URL=https://api.airplanes.live/v2
# Registered OpenSky account unlocks 4,000 req/day (used only as a secondary/validation source)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ---- NOAA Aviation Weather ----
NOAA_AWC_BASE_URL=https://aviationweather.gov/api/data

# ---- Ingest scope (CONUS bounding box) ----
INGEST_BBOX_MIN_LAT=24.5
INGEST_BBOX_MAX_LAT=49.5
# NOTE: default coverage is the 8-tile core_hub_tiles() set (not the full
# 30-hub hub_tiles()) after observing what looks like a request-budget/quota
# limit on adsb.lol rather than a plain req/s ceiling - see
# docs/adr/0003-hub-tiling.md. If the ingest log shows persistent 429s, the
# most likely cause is that budget still being exhausted from earlier
# testing; give it time to reset rather than reducing the interval further.
INGEST_BBOX_MIN_LON=-125.0
INGEST_BBOX_MAX_LON=-66.5
INGEST_POLL_INTERVAL_SECONDS=90

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_WRITE_KEY=changeme_generate_a_real_key_for_write_endpoints
CORS_ORIGINS=http://localhost:3000

# ---- LLM scenario compiler (optional - feature degrades gracefully without it) ----
ANTHROPIC_API_KEY=

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
ENVIRONMENT=development
